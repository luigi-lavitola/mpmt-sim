# readouttesting (the RBU) built from the local checkout.
#
# The repo's own Dockerfile git-clones readouttesting from the private
# GitLab, which needs credentials inside the build. This one copies the
# working tree instead, so it builds whatever is checked out — including
# uncommitted changes — and needs no registry auth.
#
# Build from the parent of the repos:
#   docker build -f mpmt-sim/docker/Dockerfile.rbu -t rbu:local .

FROM tooldaq/core

RUN cd /opt/ToolFrameworkCore && git pull && make clean && make -j$(nproc) && \
    cd /opt/ToolDAQFramework && git pull && make clean && make -j$(nproc)

COPY readouttesting /opt/readouttesting

RUN cd /opt/readouttesting && \
    ln -sf /opt ./Dependencies && \
    chmod a+x ./Setup.sh && \
    . ./Setup.sh && \
    make -j$(nproc)

WORKDIR /opt/readouttesting

CMD ["/bin/bash"]
