# The simulated mPMT node itself - sim-producer and everything it compiles in
# from m-pmt-daq-interface (built on the DAQ group's ElectronicsTemplate -
# see that repo's docs/migration-from-mpmt-daq-interface.md).
#
# Unlike docker/Dockerfile, which only runs Python and mounts the sources,
# this one has to build: sim-producer is C++ and links the production data
# path. It therefore needs the sibling checkouts at build time, so the build
# context is the parent of the repos:
#
#   docker build -f mpmt-sim/docker/Dockerfile.producer -t mpmt-node:local .
#
# One image serves every simulated node. What makes a node distinct is its
# config directory, mounted at run time - see scripts/make-node-configs.sh.

FROM gcc:13

RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake \
      libzmq3-dev \
      cppzmq-dev \
      libcurl4-openssl-dev \
      nlohmann-json3-dev \
      libboost-iostreams-dev \
      libboost-serialization-dev \
      libboost-date-time-dev \
    && rm -rf /var/lib/apt/lists/*

COPY mpmt-sim            /opt/mpmt-sim
COPY m-pmt-daq-interface  /opt/m-pmt-daq-interface
COPY libToolDAQ          /opt/libToolDAQ
COPY mpmt-mss            /opt/mpmt-mss

# The host build tree comes along with the COPY and would confuse cmake, which
# caches absolute paths from wherever it was first configured.
RUN rm -rf /opt/mpmt-sim/build

RUN cmake -S /opt/mpmt-sim -B /opt/mpmt-sim/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DMPMT_DAQ_INTERFACE_DIR=/opt/m-pmt-daq-interface \
      -DTOOLDAQ_DIR=/opt/libToolDAQ \
      -DMPMT_MSS_CPP_DIR=/opt/mpmt-mss/src/mpmt_mss/client/cpp \
    && cmake --build /opt/mpmt-sim/build --target sim-producer -j$(nproc)

# Run from the config directory: the config files name each other by relative
# path, and DAQInterface writes its generated UUID next to them.
WORKDIR /opt/node

ENV LD_LIBRARY_PATH=/opt/mpmt-sim/build/lib

CMD ["/opt/mpmt-sim/build/sim-producer"]
